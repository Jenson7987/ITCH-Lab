{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itchlab.local/schemas/replay-config.schema.json",
  "title": "ITCH-Lab replay config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input", "selection", "output", "validation"],
  "properties": {
    "schema_version": {"const": 1},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "trading_date", "exchange_timezone"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "trading_date": {"type": "string", "format": "date"},
        "exchange_timezone": {"const": "America/New_York"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbols", "session_start_ns", "session_end_ns", "require_trading_state"],
      "properties": {
        "symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/symbol"}
        },
        "session_start_ns": {"type": "integer", "minimum": 0, "maximum": 86399999999999},
        "session_end_ns": {"type": "integer", "minimum": 1, "maximum": 86400000000000},
        "require_trading_state": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth", "emit_unchanged_trade_snapshots"],
      "properties": {
        "depth": {"type": "integer", "minimum": 1, "maximum": 50},
        "emit_unchanged_trade_snapshots": {"type": "boolean"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_skipped_messages", "invariant_interval"],
      "properties": {
        "mode": {"enum": ["strict", "permissive"]},
        "max_skipped_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invariant_interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "strict"}}, "required": ["mode"]},
          "then": {"properties": {"max_skipped_messages": {"const": 0}}}
        }
      ]
    }
  },
  "$defs": {
    "symbol": {
      "type": "string",
      "pattern": "^[!-~](?:[ -~]{0,6}[!-~])?$"
    }
  }
}
