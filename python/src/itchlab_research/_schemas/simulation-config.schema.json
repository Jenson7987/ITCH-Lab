{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itchlab.local/schemas/simulation-config.schema.json",
  "title": "ITCH-Lab simulation config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_manifest", "prediction_manifest", "strategy", "execution", "seed"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_manifest": {"type": "string", "minLength": 1},
    "prediction_manifest": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "decision_interval_ns",
        "max_prediction_age_ns",
        "order_quantity",
        "inventory_limit",
        "gamma",
        "volatility_window_ns",
        "risk_horizon_seconds",
        "signal_weight_ticks",
        "max_signal_ticks"
      ],
      "properties": {
        "name": {
          "enum": [
            "inventory_aware_avellaneda_stoikov",
            "signal_adjusted_avellaneda_stoikov"
          ]
        },
        "decision_interval_ns": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "max_prediction_age_ns": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "order_quantity": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "inventory_limit": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "gamma": {"type": "number", "exclusiveMinimum": 0},
        "volatility_window_ns": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "risk_horizon_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
        "signal_weight_ticks": {"enum": [0.0, 0.5, 1.0, 2.0]},
        "max_signal_ticks": {"type": "number", "minimum": 0}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passive_only",
        "submission_latency_ns",
        "cancellation_latency_ns",
        "maker_fee_microusd_per_share",
        "taker_fee_microusd_per_share",
        "queue_policy",
        "max_queue_anomalies",
        "terminal_liquidation"
      ],
      "properties": {
        "passive_only": {"const": true},
        "submission_latency_ns": {"type": "integer", "minimum": 0, "maximum": 10000000000},
        "cancellation_latency_ns": {"type": "integer", "minimum": 0, "maximum": 10000000000},
        "maker_fee_microusd_per_share": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "taker_fee_microusd_per_share": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "queue_policy": {"const": "known_orders_conservative"},
        "max_queue_anomalies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "terminal_liquidation": {"const": "cross_visible_spread"}
      }
    },
    "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "strategy": {
            "properties": {"name": {"const": "inventory_aware_avellaneda_stoikov"}},
            "required": ["name"]
          }
        },
        "required": ["strategy"]
      },
      "then": {
        "properties": {
          "prediction_manifest": {"type": "null"},
          "strategy": {"properties": {"signal_weight_ticks": {"const": 0.0}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "strategy": {
            "properties": {"name": {"const": "signal_adjusted_avellaneda_stoikov"}},
            "required": ["name"]
          }
        },
        "required": ["strategy"]
      },
      "then": {"properties": {"prediction_manifest": {"type": "string", "minLength": 1}}}
    }
  ]
}
